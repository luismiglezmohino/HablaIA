{
  "name": "hablaia",
  "version": "0.1.0",
  "description": "HablaIA - Comunicador SAAC con Inteligencia Artificial",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && ./vendor/bin/phpstan analyse src --level=6",
    "format:frontend": "cd frontend && npm run format",
    "format:backend": "cd backend && ./vendor/bin/php-cs-fixer fix src --rules=@PSR12",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "cd backend && ./vendor/bin/pest"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,vue,js}": [
      "npm run lint:frontend"
    ],
    "backend/**/*.php": [
      "npm run lint:backend"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
