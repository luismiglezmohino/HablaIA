#!/bin/sh

# =============================================================================
# HablaIA - Pre-push Hook
# =============================================================================
# 1. Branch name validation (agnostico)
# 2. Tests (frontend + backend)
# 3. Dependency audit (contexto-aware: npm audit / composer audit)

echo "🧪 Running pre-push checks..."
echo ""

FAILED=0

# -----------------------------------------------------------------------------
# 1. Branch name validation
# -----------------------------------------------------------------------------
BRANCH=$(git rev-parse --abbrev-ref HEAD)
VALID_PREFIXES="^(feat|fix|docs|test|refactor|chore|style|perf|ci|build|hotfix|release|main|master|develop)(/.*)?$"

if ! echo "$BRANCH" | grep -qE "$VALID_PREFIXES"; then
    echo "❌ Nombre de rama invalido: '$BRANCH'"
    echo "   Prefijos validos: feat/, fix/, docs/, test/, refactor/, chore/, style/, perf/, ci/, build/, hotfix/, release/"
    echo "   Ejemplo: feat/add-login, fix/button-alignment"
    FAILED=1
fi

# -----------------------------------------------------------------------------
# Detectar contexto (que se ha modificado)
# -----------------------------------------------------------------------------
REMOTE=${1:-origin}
REMOTE_SHA=$(git rev-parse --verify "$REMOTE/$BRANCH" 2>/dev/null) || REMOTE_SHA=""

if [ -n "$REMOTE_SHA" ]; then
    CHANGED_FILES=$(git diff --name-only "$REMOTE_SHA"..HEAD 2>/dev/null || echo "")
else
    # Rama nueva: comparar contra main
    CHANGED_FILES=$(git diff --name-only origin/main..HEAD 2>/dev/null || git diff --name-only HEAD~1..HEAD 2>/dev/null || echo "")
fi

# Fallback: si no se pudo detectar, ejecutar todos los checks
if [ -z "$CHANGED_FILES" ]; then
    echo "⚠️  No se pudo determinar ficheros cambiados. Ejecutando todos los checks."
    HAS_FRONTEND="fallback"
    HAS_BACKEND="fallback"
else
    HAS_FRONTEND=$(echo "$CHANGED_FILES" | grep "^frontend/" || true)
    HAS_BACKEND=$(echo "$CHANGED_FILES" | grep "^backend/" || true)
fi

# -----------------------------------------------------------------------------
# 2. Tests
# -----------------------------------------------------------------------------

# Frontend Tests (Vitest)
if [ -n "$HAS_FRONTEND" ]; then
    echo "📦 Frontend Tests"
    echo "─────────────────"

    if [ -f "frontend/package.json" ]; then
        if [ -d "frontend/node_modules" ]; then
            cd frontend
            npm run test -- --run
            if [ $? -ne 0 ]; then
                echo "❌ Frontend tests failed!"
                FAILED=1
            else
                echo "✅ Frontend tests passed!"
            fi
            cd ..
        else
            echo "⚠️  Frontend node_modules not found. Run: cd frontend && npm install"
            FAILED=1
        fi
    fi
    echo ""

    # E2E Tests (Playwright)
    echo "🎭 E2E Tests (Playwright)"
    echo "─────────────────────────"

    DOCKER_STARTED_BY_HOOK=0
    FRONTEND_UP=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3000 2>/dev/null || echo "000")

    if [ "$FRONTEND_UP" != "200" ]; then
        echo "🐳 Docker no esta levantado. Iniciando servicios..."
        docker compose up -d
        DOCKER_STARTED_BY_HOOK=1

        for i in $(seq 1 30); do
            HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:3000 2>/dev/null || echo "000")
            if [ "$HTTP_CODE" = "200" ]; then
                echo "✅ Docker listo (intento $i)"
                break
            fi
            if [ "$i" = "30" ]; then
                echo "❌ Docker no arranco tras 30 intentos"
                FAILED=1
            fi
            sleep 2
        done
    fi

    if [ $FAILED -eq 0 ]; then
        cd frontend
        npx playwright test
        if [ $? -ne 0 ]; then
            echo "❌ E2E tests failed!"
            FAILED=1
        else
            echo "✅ E2E tests passed!"
        fi
        cd ..
    fi

    if [ $DOCKER_STARTED_BY_HOOK -eq 1 ]; then
        echo "🐳 Parando Docker (iniciado por el hook)..."
        docker compose down
    fi
    echo ""
fi

# Backend Tests (PestPHP)
if [ -n "$HAS_BACKEND" ]; then
    echo "🐘 Backend Tests"
    echo "────────────────"

    if [ -f "backend/composer.json" ]; then
        if [ -f "backend/vendor/bin/pest" ]; then
            cd backend
            ./vendor/bin/pest
            if [ $? -ne 0 ]; then
                echo "❌ Backend tests failed!"
                FAILED=1
            else
                echo "✅ Backend tests passed!"
            fi
            cd ..
        else
            echo "⚠️  Backend vendor not found. Run: cd backend && composer install"
            FAILED=1
        fi
    fi
    echo ""
fi

# Si no hay cambios en frontend ni backend, skip tests
if [ -z "$HAS_FRONTEND" ] && [ -z "$HAS_BACKEND" ]; then
    echo "ℹ️  Solo cambios en raiz/docs. Tests omitidos."
    echo ""
fi

# -----------------------------------------------------------------------------
# 3. Dependency audit (contexto-aware)
# -----------------------------------------------------------------------------

if [ -n "$HAS_FRONTEND" ]; then
    echo "🔐 Frontend Security Audit"
    echo "──────────────────────────"

    if [ -f "frontend/package.json" ]; then
        cd frontend
        npm audit --omit=dev --audit-level=high 2>/dev/null
        if [ $? -ne 0 ]; then
            echo "⚠️  npm audit encontro vulnerabilidades high/critical"
            FAILED=1
        else
            echo "✅ Frontend dependencies OK"
        fi
        cd ..
    fi
    echo ""
fi

if [ -n "$HAS_BACKEND" ]; then
    echo "🔐 Backend Security Audit"
    echo "─────────────────────────"

    if [ -f "backend/composer.json" ]; then
        cd backend
        composer audit 2>/dev/null
        if [ $? -ne 0 ]; then
            echo "⚠️  composer audit encontro vulnerabilidades"
            FAILED=1
        else
            echo "✅ Backend dependencies OK"
        fi
        cd ..
    fi
    echo ""
fi

# -----------------------------------------------------------------------------
# Final Result
# -----------------------------------------------------------------------------
if [ $FAILED -ne 0 ]; then
    echo "═══════════════════════════════════════"
    echo "❌ Pre-push checks FAILED!"
    echo "   Fix the issues above before pushing."
    echo "═══════════════════════════════════════"
    exit 1
fi

echo "═══════════════════════════════════════"
echo "✅ All pre-push checks passed!"
echo "═══════════════════════════════════════"
