#!/bin/sh

# =============================================================================
# HablaIA - Pre-commit Hook
# =============================================================================
# 1. Ficheros prohibidos (agnostico)
# 2. Deteccion de secrets en contenido (agnostico)
# 3. Lint-staged (contexto-aware: ESLint frontend, PHPStan backend)

echo "🔍 Running pre-commit checks..."

FAILED=0

# -----------------------------------------------------------------------------
# 1. Ficheros prohibidos
# -----------------------------------------------------------------------------
FORBIDDEN_PATTERNS="\.env$|\.env\.|\.pem$|\.key$|\.p12$|\.pfx$|\.jks$|credentials\.json|service-account\.json"
FORBIDDEN_FILES=$(git diff --cached --name-only | grep -E "$FORBIDDEN_PATTERNS" | grep -v "\.env\.example$" | grep -v "\.env\.test$" || true)

if [ -n "$FORBIDDEN_FILES" ]; then
    echo ""
    echo "❌ Ficheros prohibidos detectados en staging:"
    echo "$FORBIDDEN_FILES" | while read -r file; do echo "   - $file"; done
    echo ""
    echo "   Usa 'git reset HEAD <file>' para quitar del staging."
    FAILED=1
fi

# Binarios grandes (> 1MB)
LARGE_FILES=$(git diff --cached --name-only --diff-filter=d | while read -r file; do
    if [ -f "$file" ]; then
        size=$(wc -c < "$file" | tr -d ' ')
        if [ "$size" -gt 1048576 ]; then
            echo "$file ($(( size / 1024 ))KB)"
        fi
    fi
done)

if [ -n "$LARGE_FILES" ]; then
    echo ""
    echo "❌ Ficheros grandes (>1MB) detectados en staging:"
    echo "$LARGE_FILES" | while read -r file; do echo "   - $file"; done
    FAILED=1
fi

# -----------------------------------------------------------------------------
# 2. Deteccion de secrets en contenido
# -----------------------------------------------------------------------------
SECRET_PATTERNS="(PRIVATE KEY|sk-[a-zA-Z0-9]{20,}|AIza[0-9A-Za-z_-]{35}|ghp_[a-zA-Z0-9]{36}|password\s*=\s*['\"][^'\"]+['\"]|api_key\s*=\s*['\"][^'\"]+['\"])"
STAGED_CONTENT=$(git diff --cached --diff-filter=d -- . ':!.husky/' -U0 | grep "^+" | grep -v "^+++" | grep -iE "$SECRET_PATTERNS" | grep -v "example" | grep -v "YOUR_" | grep -v "fake" | grep -v "test" | grep -v "\.env\." || true)

if [ -n "$STAGED_CONTENT" ]; then
    echo ""
    echo "⚠️  Posibles secrets detectados en contenido staged:"
    echo "$STAGED_CONTENT" | head -5 | while read -r line; do echo "   $line"; done
    echo ""
    echo "   Revisa que no sean credenciales reales."
    echo "   Si es un falso positivo, commitea con: git commit --no-verify"
    FAILED=1
fi

# -----------------------------------------------------------------------------
# 3. Lint-staged
# -----------------------------------------------------------------------------
if [ $FAILED -eq 0 ]; then
    if ! command -v npx &> /dev/null; then
        echo "❌ npx not found. Please install Node.js"
        exit 1
    fi

    npx lint-staged
    if [ $? -ne 0 ]; then
        echo ""
        echo "❌ Lint-staged checks failed!"
        FAILED=1
    fi
fi

# -----------------------------------------------------------------------------
# Final Result
# -----------------------------------------------------------------------------
if [ $FAILED -ne 0 ]; then
    echo ""
    echo "❌ Pre-commit checks failed!"
    echo "   Fix the issues above before committing."
    exit 1
fi

echo "✅ Pre-commit checks passed!"
