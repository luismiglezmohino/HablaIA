# Environment
APP_ENV=dev
APP_SECRET=change_me_in_production_please_use_32_chars
APP_DEBUG=1

# Database
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"

# CORS (production: '^https://damevozya\.es$')
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Trusted Proxies (Docker: REMOTE_ADDR, Production: load balancer IPs)
TRUSTED_PROXIES=REMOTE_ADDR

# Rate Limiting
PHRASE_RATE_LIMIT=30
PHRASE_RATE_INTERVAL=60
PHRASE_DAILY_LIMIT=500
SEARCH_RATE_LIMIT=30
SEARCH_RATE_INTERVAL=60

# Phrase Generation (shared across providers)
# PHRASE_PROVIDER: openai (default, Groq via OpenAI-compatible API), gemini, fake
PHRASE_PROVIDER=openai
PHRASE_TEMPERATURE=0.7
PHRASE_MAX_TOKENS=2048
PHRASE_TIMEOUT=10

# Groq Configuration (default - free tier, OpenAI-compatible)
OPENAI_API_URL=https://api.groq.com/openai/v1/chat/completions
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-oss-120b

# Gemini Configuration (alternative)
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Sentry (empty = disabled)
SENTRY_DSN=
